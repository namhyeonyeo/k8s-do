#!/usr/bin/env bash

set -Eeuo pipefail

VERSION="3.2.0"
CONFIG_FILE="${K8S_DO_CONFIG:-/etc/k8s-do/config.sh}"

if [[ ! -f "$CONFIG_FILE" ]]; then
  echo "[ERROR] Config file not found: $CONFIG_FILE" >&2
  echo "        Set K8S_DO_CONFIG to the correct config path." >&2
  exit 1
fi

# shellcheck disable=SC1090
source "$CONFIG_FILE"

: "${K8S_DO_USER:=vmware-system-user}"
: "${KUBECTL_BIN:=kubectl}"
: "${SSH_BIN:=ssh}"
: "${CLUSTER_DISCOVERY_MODE:=static}"
: "${SUPERVISOR_CLUSTER_RESOURCE:=clusters.cluster.x-k8s.io}"
: "${KUBECTL_REQUEST_TIMEOUT:=5s}"
: "${NODE_CACHE_TTL:=20}"
: "${CLUSTER_CACHE_TTL:=30}"
: "${ASSET_CACHE_TTL:=300}"
: "${KUBECONFIG_SECRET_SUFFIX:=-kubeconfig}"
: "${KUBECONFIG_SECRET_KEY:=value}"
: "${SSH_SECRET_SUFFIX:=-ssh}"
: "${SSH_SECRET_KEY:=ssh-privatekey}"
: "${K8S_DO_CACHE_DIR:=${XDG_CACHE_HOME:-$HOME/.cache}/k8s-do}"
: "${K8S_DO_KNOWN_HOSTS:=${XDG_STATE_HOME:-$HOME/.local/state}/k8s-do/known_hosts}"
: "${FIX_TOOL_NAMESPACE:=fix-tool}"
: "${FIX_TOOL_POD_PREFIX:=fix-tool}"
: "${EGRESS_CHECK_TIMEOUT:=10}"
: "${STATIC_KUBECONFIG_DIR:=}"
: "${STATIC_PRIVATE_KEY_DIR:=}"

if ! declare -p K8S_DO_OPTS >/dev/null 2>&1; then
  K8S_DO_OPTS=(
    -o IdentitiesOnly=yes
    -o PreferredAuthentications=publickey
    -o PasswordAuthentication=no
    -o StrictHostKeyChecking=accept-new
    -o ConnectTimeout=5
  )
fi

mkdir -p "$K8S_DO_CACHE_DIR/nodes" "$K8S_DO_CACHE_DIR/assets"
mkdir -p "$(dirname "$K8S_DO_KNOWN_HOSTS")"
chmod 700 "$K8S_DO_CACHE_DIR" "$K8S_DO_CACHE_DIR/nodes" "$K8S_DO_CACHE_DIR/assets" 2>/dev/null || true
touch "$K8S_DO_KNOWN_HOSTS"
chmod 600 "$K8S_DO_KNOWN_HOSTS" 2>/dev/null || true

RUNTIME_DIR=""
CLUSTER_SOURCE=""
CLUSTER_REF=""
CLUSTER_NAMESPACE=""
CLUSTER_NAME=""
KUBECONFIG_PATH=""
PRIVATE_KEY_PATH=""
NODE_ROWS=()

cleanup() {
  if [[ -n "$RUNTIME_DIR" && -d "$RUNTIME_DIR" ]]; then
    rm -rf "$RUNTIME_DIR"
  fi
}
trap cleanup EXIT

log_info()  { printf '[INFO] %s\n' "$*" >&2; }
log_warn()  { printf '[WARN] %s\n' "$*" >&2; }
log_error() { printf '[ERROR] %s\n' "$*" >&2; }

show_usage() {
  cat <<'EOF_USAGE'
Usage:
  k8s-do list
  k8s-do nodes <cluster>
  k8s-do <cluster>
  k8s-do <cluster> <node-name|node-ip|index>
  k8s-do check <cluster> <node-name|node-ip|index>
  k8s-do exec <cluster> <node-name|node-ip|index> -- '<remote command>'
  k8s-do doctor <cluster> <node-name|node-ip|index> [--output <file>]
  k8s-do egress-check <cluster> <node-name|node-ip|index> \
      --egress-ip <ip> --dst <ip> --port <port> \
      [--namespace <ns>] [--pod-prefix <prefix>] [--pod <name>] \
      [--container <name>] [--iface <interface>] [--timeout <seconds>] \
      [--output <file>]
  k8s-do refresh [cluster]
  k8s-do version
  k8s-do help

Cluster formats:
  static mode      : dev-workload
  supervisor mode  : namespace/cluster-name
  alias (optional) : dev-workload -> namespace/cluster-name

Examples:
  k8s-do list
  k8s-do nodes dev-workload
  k8s-do dev-workload
  k8s-do dev-workload worker-node-01
  k8s-do dev-workload 2
  k8s-do exec dev-workload worker-node-01 -- 'sudo journalctl -u kubelet -n 100 --no-pager'
  k8s-do doctor dev-workload worker-node-01
  k8s-do egress-check dev-workload worker-node-01 --egress-ip 10.60.93.191 --dst 10.60.191.31 --port 8522

Egress check defaults:
  namespace  : fix-tool
  pod prefix : fix-tool
  The command finds one Running matching Pod, starts packet/conntrack capture on the Egress Node,
  generates TCP traffic from the Pod, and prints an evidence-based verdict.
EOF_USAGE
}

require_command() {
  command -v "$1" >/dev/null 2>&1 || {
    log_error "Required command not found: $1"
    return 1
  }
}

mode_has_static() {
  [[ "$CLUSTER_DISCOVERY_MODE" == "static" || "$CLUSTER_DISCOVERY_MODE" == "hybrid" ]]
}

mode_has_supervisor() {
  [[ "$CLUSTER_DISCOVERY_MODE" == "supervisor" || "$CLUSTER_DISCOVERY_MODE" == "hybrid" ]]
}

safe_cache_name() {
  printf '%s' "$1" | tr '/: ' '___' | tr -cd '[:alnum:]_.-'
}

cache_is_fresh() {
  local file="$1"
  local ttl="$2"
  [[ -f "$file" ]] || return 1

  local now mtime
  now=$(date +%s)
  mtime=$(stat -c %Y "$file" 2>/dev/null || stat -f %m "$file" 2>/dev/null || echo 0)
  (( now - mtime < ttl ))
}

kubectl_supervisor() {
  [[ -n "${SUPERVISOR_KUBECONFIG:-}" ]] || {
    log_error "SUPERVISOR_KUBECONFIG is not configured."
    return 1
  }
  [[ -f "$SUPERVISOR_KUBECONFIG" ]] || {
    log_error "Supervisor kubeconfig not found: $SUPERVISOR_KUBECONFIG"
    return 1
  }

  "$KUBECTL_BIN" \
    --kubeconfig "$SUPERVISOR_KUBECONFIG" \
    --request-timeout="$KUBECTL_REQUEST_TIMEOUT" \
    "$@"
}

static_ref_from_filename() {
  local name
  name=$(basename "$1")
  case "$name" in
    *.kubeconfig) name="${name%.kubeconfig}" ;;
    *.conf)       name="${name%.conf}" ;;
    *.yaml)       name="${name%.yaml}" ;;
    *.yml)        name="${name%.yml}" ;;
  esac
  printf '%s\n' "$name"
}

discover_static_kubeconfigs() {
  [[ -n "${STATIC_KUBECONFIG_DIR:-}" && -d "$STATIC_KUBECONFIG_DIR" ]] || return 0

  local file ref
  while IFS= read -r -d '' file; do
    ref=$(static_ref_from_filename "$file")
    [[ -n "$ref" ]] && printf '%s\t%s\n' "$ref" "$file"
  done < <(find "$STATIC_KUBECONFIG_DIR" -maxdepth 1 -type f ! -name '.*' -print0 2>/dev/null | sort -z)
}

resolve_discovered_kubeconfig() {
  local cluster="$1"
  local matches=() ref file

  while IFS=$'\t' read -r ref file; do
    [[ -n "$ref" ]] || continue
    if [[ "$cluster" == "$ref" || "$cluster" == "$(basename "$file")" ]]; then
      matches+=("$file")
    fi
  done < <(discover_static_kubeconfigs)

  if ((${#matches[@]} == 1)); then
    printf '%s\n' "${matches[0]}"
    return 0
  fi

  if ((${#matches[@]} > 1)); then
    log_error "Multiple kubeconfig files map to static cluster [$cluster]."
    printf '        Rename files so each cluster has one unique filename.\n' >&2
    printf '        - %s\n' "${matches[@]}" >&2
  fi
  return 1
}

resolve_static_kubeconfig() {
  local cluster="$1"

  if [[ -n "${STATIC_KUBECONFIG_DIR:-}" ]]; then
    resolve_discovered_kubeconfig "$cluster" && return 0
  fi

  if declare -F get_cluster_kubeconfig >/dev/null 2>&1; then
    get_cluster_kubeconfig "$cluster" && return 0
  fi

  return 1
}

resolve_static_private_key() {
  local cluster="$1"

  if [[ -n "${STATIC_PRIVATE_KEY_DIR:-}" && -d "$STATIC_PRIVATE_KEY_DIR" ]]; then
    local candidate
    for candidate in \
      "$STATIC_PRIVATE_KEY_DIR/$cluster" \
      "$STATIC_PRIVATE_KEY_DIR/$cluster.pem" \
      "$STATIC_PRIVATE_KEY_DIR/$cluster.key"; do
      if [[ -f "$candidate" ]]; then
        printf '%s\n' "$candidate"
        return 0
      fi
    done
  fi

  if declare -F get_cluster_private_key >/dev/null 2>&1; then
    get_cluster_private_key "$cluster" && return 0
  fi

  return 1
}

list_static_clusters() {
  {
    if [[ -n "${STATIC_KUBECONFIG_DIR:-}" ]]; then
      discover_static_kubeconfigs | cut -f1
    fi
    if declare -p CLUSTERS >/dev/null 2>&1; then
      printf '%s\n' "${CLUSTERS[@]}"
    fi
  } | sed '/^$/d' | sort -u
}

fetch_supervisor_clusters() {
  kubectl_supervisor get "$SUPERVISOR_CLUSTER_RESOURCE" -A \
    -o jsonpath='{range .items[*]}{.metadata.namespace}{"/"}{.metadata.name}{"\t"}{.status.phase}{"\t"}{.status.conditions[?(@.type=="Ready")].status}{"\n"}{end}'
}

list_supervisor_clusters_tsv() {
  local cache_file="$K8S_DO_CACHE_DIR/clusters.tsv"

  if cache_is_fresh "$cache_file" "$CLUSTER_CACHE_TTL"; then
    cat "$cache_file"
    return 0
  fi

  local tmp
  tmp=$(mktemp "$K8S_DO_CACHE_DIR/.clusters.XXXXXX")

  if fetch_supervisor_clusters >"$tmp" 2>/dev/null; then
    chmod 600 "$tmp"
    mv -f "$tmp" "$cache_file"
    cat "$cache_file"
    return 0
  fi

  rm -f "$tmp"
  if [[ -s "$cache_file" ]]; then
    log_warn "Supervisor API unavailable; using stale cluster cache."
    cat "$cache_file"
    return 0
  fi

  return 1
}

list_all_cluster_refs() {
  {
    if mode_has_static; then
      list_static_clusters
    fi
    if mode_has_supervisor; then
      list_supervisor_clusters_tsv 2>/dev/null | cut -f1
    fi
    if declare -p CLUSTER_ALIASES >/dev/null 2>&1; then
      printf '%s\n' "${!CLUSTER_ALIASES[@]}"
    fi
  } | sed '/^$/d' | sort -u
}

print_cluster_list() {
  printf '%-36s %-12s %-8s %s\n' "CLUSTER" "SOURCE" "READY" "PHASE"
  printf '%-36s %-12s %-8s %s\n' "-------" "------" "-----" "-----"

  if mode_has_static; then
    local c
    while IFS= read -r c; do
      [[ -n "$c" ]] && printf '%-36s %-12s %-8s %s\n' "$c" "static" "-" "-"
    done < <(list_static_clusters)
  fi

  if mode_has_supervisor; then
    local ref phase ready
    while IFS=$'\t' read -r ref phase ready; do
      [[ -n "$ref" ]] || continue
      printf '%-36s %-12s %-8s %s\n' "$ref" "supervisor" "${ready:--}" "${phase:--}"
    done < <(list_supervisor_clusters_tsv)
  fi

  if declare -p CLUSTER_ALIASES >/dev/null 2>&1 && ((${#CLUSTER_ALIASES[@]} > 0)); then
    echo
    echo "Aliases:"
    local alias
    for alias in "${!CLUSTER_ALIASES[@]}"; do
      printf '  %-24s -> %s\n' "$alias" "${CLUSTER_ALIASES[$alias]}"
    done | sort
  fi
}

resolve_alias() {
  local input="$1"
  if declare -p CLUSTER_ALIASES >/dev/null 2>&1 && [[ -n "${CLUSTER_ALIASES[$input]+x}" ]]; then
    printf '%s\n' "${CLUSTER_ALIASES[$input]}"
  else
    printf '%s\n' "$input"
  fi
}

static_cluster_exists() {
  local cluster="$1"
  resolve_static_kubeconfig "$cluster" >/dev/null 2>&1
}

resolve_supervisor_ref() {
  local input="$1"

  if [[ "$input" == */* ]]; then
    local matches
    matches=$(list_supervisor_clusters_tsv | cut -f1 | grep -Fx "$input" || true)
    [[ -n "$matches" ]] || {
      log_error "Supervisor cluster not found: $input"
      return 1
    }
    printf '%s\n' "$input"
    return 0
  fi

  local matches=()
  mapfile -t matches < <(list_supervisor_clusters_tsv | cut -f1 | awk -F/ -v name="$input" '$2 == name')

  if ((${#matches[@]} == 1)); then
    printf '%s\n' "${matches[0]}"
    return 0
  fi

  if ((${#matches[@]} == 0)); then
    log_error "Supervisor cluster not found: $input"
  else
    log_error "Cluster name is ambiguous: $input"
    printf '        Use namespace/cluster-name. Candidates:\n' >&2
    printf '        - %s\n' "${matches[@]}" >&2
  fi
  return 1
}

resolve_cluster() {
  local input
  input=$(resolve_alias "$1")

  if mode_has_static && static_cluster_exists "$input"; then
    CLUSTER_SOURCE="static"
    CLUSTER_REF="$input"
    CLUSTER_NAME="$input"
    CLUSTER_NAMESPACE=""
    return 0
  fi

  if mode_has_supervisor; then
    CLUSTER_REF=$(resolve_supervisor_ref "$input") || return 1
    CLUSTER_SOURCE="supervisor"
    CLUSTER_NAMESPACE="${CLUSTER_REF%%/*}"
    CLUSTER_NAME="${CLUSTER_REF#*/}"
    return 0
  fi

  log_error "Unsupported cluster: $1"
  return 1
}

extract_secret_to_file() {
  local namespace="$1"
  local secret_name="$2"
  local data_key="$3"
  local destination="$4"

  local encoded tmp
  encoded=$(kubectl_supervisor -n "$namespace" get secret "$secret_name" \
    -o go-template="{{index .data \"$data_key\"}}") || return 1

  [[ -n "$encoded" && "$encoded" != "<no value>" ]] || {
    log_error "Secret key not found: ${namespace}/${secret_name} data.${data_key}"
    return 1
  }

  tmp=$(mktemp "${destination}.tmp.XXXXXX")
  umask 077
  if ! printf '%s' "$encoded" | base64 --decode >"$tmp" 2>/dev/null; then
    printf '%s' "$encoded" | base64 -d >"$tmp"
  fi
  chmod 600 "$tmp"
  mv -f "$tmp" "$destination"
}

resolve_cluster_kubeconfig() {
  local requested="$1"
  resolve_cluster "$requested"

  if [[ "$CLUSTER_SOURCE" == "static" ]]; then
    KUBECONFIG_PATH=$(resolve_static_kubeconfig "$CLUSTER_REF") || {
      log_error "No kubeconfig mapping for cluster: $CLUSTER_REF"
      return 1
    }
    [[ -f "$KUBECONFIG_PATH" ]] || {
      log_error "kubeconfig not found: $KUBECONFIG_PATH"
      return 1
    }
    return 0
  fi

  local safe cache_file
  safe=$(safe_cache_name "$CLUSTER_REF")
  cache_file="$K8S_DO_CACHE_DIR/assets/${safe}.kubeconfig"

  if ! cache_is_fresh "$cache_file" "$ASSET_CACHE_TTL"; then
    extract_secret_to_file \
      "$CLUSTER_NAMESPACE" \
      "${CLUSTER_NAME}${KUBECONFIG_SECRET_SUFFIX}" \
      "$KUBECONFIG_SECRET_KEY" \
      "$cache_file" || return 1
  fi

  KUBECONFIG_PATH="$cache_file"
}

resolve_private_key() {
  if [[ "$CLUSTER_SOURCE" == "static" ]]; then
    PRIVATE_KEY_PATH=$(resolve_static_private_key "$CLUSTER_REF") || {
      log_error "No private key mapping for cluster: $CLUSTER_REF"
      return 1
    }
    [[ -f "$PRIVATE_KEY_PATH" ]] || {
      log_error "Private key not found: $PRIVATE_KEY_PATH"
      return 1
    }
    return 0
  fi

  if [[ -z "$RUNTIME_DIR" ]]; then
    RUNTIME_DIR=$(mktemp -d "${TMPDIR:-/tmp}/k8s-do.XXXXXX")
    chmod 700 "$RUNTIME_DIR"
  fi

  PRIVATE_KEY_PATH="$RUNTIME_DIR/${CLUSTER_NAME}.key"
  extract_secret_to_file \
    "$CLUSTER_NAMESPACE" \
    "${CLUSTER_NAME}${SSH_SECRET_SUFFIX}" \
    "$SSH_SECRET_KEY" \
    "$PRIVATE_KEY_PATH"
}

node_cache_file() {
  local cluster="$1"
  printf '%s/nodes/%s.tsv\n' "$K8S_DO_CACHE_DIR" "$(safe_cache_name "$cluster")"
}

fetch_node_rows() {
  "$KUBECTL_BIN" \
    --kubeconfig "$KUBECONFIG_PATH" \
    --request-timeout="$KUBECTL_REQUEST_TIMEOUT" \
    get nodes \
    -o go-template='{{range .items}}{{$ip := "-"}}{{$ready := "Unknown"}}{{range .status.addresses}}{{if eq .type "InternalIP"}}{{$ip = .address}}{{end}}{{end}}{{range .status.conditions}}{{if eq .type "Ready"}}{{$ready = .status}}{{end}}{{end}}{{.metadata.name}}{{"\t"}}{{$ip}}{{"\t"}}{{$ready}}{{"\t"}}{{if .spec.unschedulable}}true{{else}}false{{end}}{{"\t"}}{{.status.nodeInfo.kubeletVersion}}{{"\n"}}{{end}}'
}

load_node_rows() {
  local requested="$1"
  local force_refresh="${2:-false}"
  resolve_cluster_kubeconfig "$requested"

  local cache_file tmp
  cache_file=$(node_cache_file "$CLUSTER_REF")

  if [[ "$force_refresh" != "true" ]] && cache_is_fresh "$cache_file" "$NODE_CACHE_TTL"; then
    mapfile -t NODE_ROWS <"$cache_file"
    return 0
  fi

  tmp=$(mktemp "$K8S_DO_CACHE_DIR/nodes/.nodes.XXXXXX")
  if fetch_node_rows >"$tmp" 2>/dev/null && [[ -s "$tmp" ]]; then
    chmod 600 "$tmp"
    mv -f "$tmp" "$cache_file"
    mapfile -t NODE_ROWS <"$cache_file"
    return 0
  fi

  rm -f "$tmp"
  if [[ -s "$cache_file" ]]; then
    log_warn "Kubernetes API unavailable; using stale node cache for $CLUSTER_REF."
    mapfile -t NODE_ROWS <"$cache_file"
    return 0
  fi

  log_error "Could not retrieve nodes from cluster: $CLUSTER_REF"
  return 1
}

print_nodes_table() {
  local i=0 name ip ready unsched version scheduling status

  printf '%-5s %-55s %-16s %-10s %-12s %s\n' "INDEX" "NODE" "INTERNAL-IP" "STATUS" "SCHEDULING" "VERSION"
  printf '%-5s %-55s %-16s %-10s %-12s %s\n' "-----" "----" "-----------" "------" "----------" "-------"

  local row
  for row in "${NODE_ROWS[@]}"; do
    IFS=$'\t' read -r name ip ready unsched version <<<"$row"
    ((i += 1))
    [[ "$ready" == "True" ]] && status="Ready" || status="NotReady"
    [[ "$unsched" == "true" ]] && scheduling="Disabled" || scheduling="Enabled"
    printf '%-5s %-55s %-16s %-10s %-12s %s\n' \
      "$i" "$name" "${ip:--}" "$status" "$scheduling" "$version"
  done
}

resolve_node_target() {
  local target="$1"
  local i=0 name ip ready unsched version
  local matches=()

  if [[ "$target" =~ ^[0-9]+$ ]] && ((target >= 1 && target <= ${#NODE_ROWS[@]})); then
    IFS=$'\t' read -r name ip ready unsched version <<<"${NODE_ROWS[target-1]}"
    printf '%s\t%s\n' "$name" "$ip"
    return 0
  fi

  local row
  for row in "${NODE_ROWS[@]}"; do
    IFS=$'\t' read -r name ip ready unsched version <<<"$row"
    ((i += 1))
    if [[ "$target" == "$name" || "$target" == "$ip" ]]; then
      matches+=("$name"$'\t'"$ip")
    fi
  done

  if ((${#matches[@]} == 1)); then
    printf '%s\n' "${matches[0]}"
    return 0
  fi

  log_error "Node target does not belong to cluster [$CLUSTER_REF]: $target"
  print_nodes_table >&2
  return 1
}

select_node_interactively() {
  print_nodes_table >&2

  [[ -t 0 && -t 1 ]] || {
    log_error "Interactive node selection requires a TTY. Specify node name, IP, or index."
    return 2
  }

  local selected
  if command -v fzf >/dev/null 2>&1; then
    local menu=() row name ip ready unsched version i=0 status scheduling
    for row in "${NODE_ROWS[@]}"; do
      IFS=$'\t' read -r name ip ready unsched version <<<"$row"
      ((i += 1))
      [[ "$ready" == "True" ]] && status="Ready" || status="NotReady"
      [[ "$unsched" == "true" ]] && scheduling="Disabled" || scheduling="Enabled"
      menu+=("$(printf '%s\t%s\t%s\t%s\t%s' "$i" "$name" "$ip" "$status" "$scheduling")")
    done
    selected=$(printf '%s\n' "${menu[@]}" | fzf --delimiter=$'\t' --with-nth=1,2,3,4,5 --header=$'INDEX\tNODE\tIP\tSTATUS\tSCHEDULING') || return 1
    printf '%s\n' "$selected" | cut -f1
    return 0
  fi

  printf '\nSelect node by INDEX, NODE, or IP: ' >&2
  IFS= read -r selected
  [[ -n "$selected" ]] || return 1
  printf '%s\n' "$selected"
}

ssh_base_args() {
  SSH_ARGS=(
    -i "$PRIVATE_KEY_PATH"
    -o UserKnownHostsFile="$K8S_DO_KNOWN_HOSTS"
    "${K8S_DO_OPTS[@]}"
  )
}

prepare_connection() {
  local cluster="$1"
  local target="$2"
  load_node_rows "$cluster"
  resolve_private_key

  local resolved
  resolved=$(resolve_node_target "$target") || return 1
  TARGET_NODE_NAME="${resolved%%$'\t'*}"
  TARGET_NODE_IP="${resolved#*$'\t'}"

  [[ -n "$TARGET_NODE_IP" && "$TARGET_NODE_IP" != "-" ]] || {
    log_error "Node has no InternalIP: $TARGET_NODE_NAME"
    return 1
  }

  ssh_base_args
}

run_ssh() {
  local cluster="$1"
  local target="$2"
  prepare_connection "$cluster" "$target"

  log_info "Cluster : $CLUSTER_REF"
  log_info "Node    : $TARGET_NODE_NAME"
  log_info "IP      : $TARGET_NODE_IP"
  log_info "User    : $K8S_DO_USER"

  local rc=0
  if "$SSH_BIN" "${SSH_ARGS[@]}" "${K8S_DO_USER}@${TARGET_NODE_IP}"; then
    rc=0
  else
    rc=$?
  fi

  if ((rc == 255)); then
    log_error "SSH connection/authentication failed. Verify route, host key, user, and private key."
  elif ((rc != 0)); then
    log_warn "SSH session ended with remote exit code: $rc"
  fi
  return "$rc"
}

run_check() {
  local cluster="$1"
  local target="$2"
  prepare_connection "$cluster" "$target"

  local rc=0
  if "$SSH_BIN" "${SSH_ARGS[@]}" -o BatchMode=yes \
      "${K8S_DO_USER}@${TARGET_NODE_IP}" 'hostname' >/dev/null; then
    printf '[OK] cluster=%s node=%s ip=%s ssh=reachable\n' "$CLUSTER_REF" "$TARGET_NODE_NAME" "$TARGET_NODE_IP"
  else
    rc=$?
    printf '[FAIL] cluster=%s node=%s ip=%s ssh=unreachable rc=%s\n' \
      "$CLUSTER_REF" "$TARGET_NODE_NAME" "$TARGET_NODE_IP" "$rc" >&2
    return "$rc"
  fi
}

run_exec() {
  local cluster="$1"
  local target="$2"
  shift 2
  [[ "${1:-}" == "--" ]] && shift
  (($# > 0)) || {
    log_error "Remote command is required."
    return 1
  }

  prepare_connection "$cluster" "$target"

  local remote_command
  remote_command="$*"
  local quoted
  printf -v quoted '%q' "$remote_command"

  "$SSH_BIN" "${SSH_ARGS[@]}" \
    "${K8S_DO_USER}@${TARGET_NODE_IP}" \
    "bash -lc $quoted"
}

run_doctor() {
  local cluster="$1"
  local target="$2"
  shift 2

  local output_file=""
  while (($#)); do
    case "$1" in
      --output)
        output_file="${2:-}"
        [[ -n "$output_file" ]] || { log_error "--output requires a file path"; return 1; }
        shift 2
        ;;
      *) log_error "Unknown doctor option: $1"; return 1 ;;
    esac
  done

  prepare_connection "$cluster" "$target"
  [[ -n "$output_file" ]] || output_file="k8s-do-doctor-$(safe_cache_name "$CLUSTER_REF")-$(safe_cache_name "$TARGET_NODE_NAME")-$(date +%Y%m%d-%H%M%S).log"

  {
    echo "# k8s-do doctor"
    echo "timestamp=$(date -Is)"
    echo "cluster=$CLUSTER_REF"
    echo "node=$TARGET_NODE_NAME"
    echo "ip=$TARGET_NODE_IP"
    echo

    echo "## Kubernetes Node"
    "$KUBECTL_BIN" --kubeconfig "$KUBECONFIG_PATH" describe node "$TARGET_NODE_NAME" 2>&1 || true
    echo

    echo "## Pods on Node"
    "$KUBECTL_BIN" --kubeconfig "$KUBECONFIG_PATH" get pods -A \
      --field-selector "spec.nodeName=$TARGET_NODE_NAME" -o wide 2>&1 || true
    echo

    echo "## Node Events"
    "$KUBECTL_BIN" --kubeconfig "$KUBECONFIG_PATH" get events -A \
      --field-selector "involvedObject.kind=Node,involvedObject.name=$TARGET_NODE_NAME" \
      --sort-by='.lastTimestamp' 2>&1 || true
    echo

    echo "## Remote Node Checks"
    "$SSH_BIN" "${SSH_ARGS[@]}" "${K8S_DO_USER}@${TARGET_NODE_IP}" 'bash -s' <<'REMOTE_DOCTOR' 2>&1 || true
set +e
section() { printf '\n### %s\n' "$1"; }

section "Identity and Uptime"
hostname -f 2>/dev/null || hostname
date -Is
uptime

section "Addresses"
ip -br addr

section "Routes"
ip route
ip -6 route 2>/dev/null || true

section "Neighbors"
ip neigh

section "Sockets Summary"
ss -s 2>/dev/null || true

section "Filesystem"
df -hT
df -ih

section "Memory"
free -m

section "Pressure"
cat /proc/pressure/cpu 2>/dev/null || true
cat /proc/pressure/memory 2>/dev/null || true
cat /proc/pressure/io 2>/dev/null || true

section "Services"
for svc in kubelet containerd; do
  printf '%-12s ' "$svc"
  sudo -n systemctl is-active "$svc" 2>/dev/null || systemctl is-active "$svc" 2>/dev/null || true
done

section "Kubelet Warnings - Last 30 Minutes"
sudo -n journalctl -u kubelet --since '-30 min' -p warning --no-pager -n 200 2>/dev/null || \
  journalctl -u kubelet --since '-30 min' -p warning --no-pager -n 200 2>/dev/null || true

section "Container Runtime"
sudo -n crictl info 2>/dev/null | head -n 80 || true
sudo -n crictl ps -a 2>/dev/null | head -n 100 || true

section "Kernel Warnings"
sudo -n dmesg --level=err,warn 2>/dev/null | tail -n 120 || true
REMOTE_DOCTOR
  } | tee "$output_file"

  log_info "Doctor report saved: $output_file"
}

validate_ipv4_or_ipv6() {
  [[ "$1" =~ ^[0-9A-Fa-f:.]+$ ]]
}

run_egress_check() {
  local cluster="$1"
  local target="$2"
  shift 2

  local egress_ip="" dst="" port="" iface=""
  local namespace="$FIX_TOOL_NAMESPACE"
  local pod_prefix="$FIX_TOOL_POD_PREFIX"
  local pod_name="" container_name=""
  local timeout_seconds="$EGRESS_CHECK_TIMEOUT"
  local capture_seconds=""
  local output_file=""

  while (($#)); do
    case "$1" in
      --egress-ip)  egress_ip="${2:-}"; shift 2 ;;
      --dst)        dst="${2:-}"; shift 2 ;;
      --port)       port="${2:-}"; shift 2 ;;
      --iface)      iface="${2:-}"; shift 2 ;;
      --namespace)  namespace="${2:-}"; shift 2 ;;
      --pod-prefix) pod_prefix="${2:-}"; shift 2 ;;
      --pod)        pod_name="${2:-}"; shift 2 ;;
      --container)  container_name="${2:-}"; shift 2 ;;
      --timeout)    timeout_seconds="${2:-}"; shift 2 ;;
      --output)     output_file="${2:-}"; shift 2 ;;
      *) log_error "Unknown egress-check option: $1"; return 1 ;;
    esac
  done

  [[ -n "$egress_ip" ]] || { log_error "--egress-ip is required"; return 1; }
  [[ -n "$dst" ]]       || { log_error "--dst is required"; return 1; }
  [[ -n "$port" ]]      || { log_error "--port is required"; return 1; }
  validate_ipv4_or_ipv6 "$egress_ip" || { log_error "Invalid egress IP: $egress_ip"; return 1; }
  validate_ipv4_or_ipv6 "$dst" || { log_error "Invalid destination IP: $dst"; return 1; }
  [[ "$port" =~ ^[0-9]+$ ]] && ((port >= 1 && port <= 65535)) || { log_error "Invalid port: $port"; return 1; }
  [[ "$timeout_seconds" =~ ^[0-9]+$ ]] && ((timeout_seconds >= 3 && timeout_seconds <= 120)) || { log_error "--timeout must be between 3 and 120 seconds"; return 1; }
  capture_seconds=$((timeout_seconds + 5))
  [[ "$namespace" =~ ^[[:alnum:]_.-]+$ ]] || { log_error "Invalid namespace: $namespace"; return 1; }
  [[ "$pod_prefix" =~ ^[[:alnum:]_.-]+$ ]] || { log_error "Invalid pod prefix: $pod_prefix"; return 1; }
  [[ -z "$pod_name" || "$pod_name" =~ ^[[:alnum:]_.-]+$ ]] || { log_error "Invalid pod name: $pod_name"; return 1; }
  [[ -z "$container_name" || "$container_name" =~ ^[[:alnum:]_.-]+$ ]] || { log_error "Invalid container name: $container_name"; return 1; }
  [[ -z "$iface" || "$iface" =~ ^[[:alnum:]_.:@-]+$ ]] || { log_error "Invalid interface: $iface"; return 1; }

  prepare_connection "$cluster" "$target"

  local pod_rows=()
  if [[ -z "$pod_name" ]]; then
    mapfile -t pod_rows < <(
      "$KUBECTL_BIN" --kubeconfig "$KUBECONFIG_PATH" --request-timeout="$KUBECTL_REQUEST_TIMEOUT" \
        -n "$namespace" get pods --field-selector=status.phase=Running \
        -o go-template='{{range .items}}{{.metadata.name}}{{"\t"}}{{.status.podIP}}{{"\t"}}{{.spec.nodeName}}{{"\n"}}{{end}}' 2>/dev/null |
      awk -F '\t' -v p="$pod_prefix" 'index($1,p)==1'
    )

    if ((${#pod_rows[@]} == 0)); then
      log_error "No Running Pod with prefix '$pod_prefix' found in namespace '$namespace'."
      return 1
    elif ((${#pod_rows[@]} > 1)); then
      log_error "Multiple Running Pods matched prefix '$pod_prefix' in namespace '$namespace'."
      printf '        - %s\n' "${pod_rows[@]%%$'\t'*}" >&2
      log_error "Specify one with --pod <pod-name>."
      return 1
    fi
    pod_name="${pod_rows[0]%%$'\t'*}"
  fi

  local pod_info pod_ip pod_node pod_phase
  pod_info=$("$KUBECTL_BIN" --kubeconfig "$KUBECONFIG_PATH" --request-timeout="$KUBECTL_REQUEST_TIMEOUT" \
    -n "$namespace" get pod "$pod_name" \
    -o go-template='{{.status.phase}}{{"\t"}}{{.status.podIP}}{{"\t"}}{{.spec.nodeName}}' 2>/dev/null) || {
      log_error "Pod not found or unreadable: ${namespace}/${pod_name}"
      return 1
    }
  IFS=$'\t' read -r pod_phase pod_ip pod_node <<<"$pod_info"
  [[ "$pod_phase" == "Running" ]] || { log_error "Pod is not Running: ${namespace}/${pod_name} phase=$pod_phase"; return 1; }
  [[ -n "$pod_ip" ]] || { log_error "Pod has no IP: ${namespace}/${pod_name}"; return 1; }

  local exec_container_args=()
  if [[ -n "$container_name" ]]; then
    exec_container_args=(-c "$container_name")
  fi

  [[ -n "$output_file" ]] || output_file="k8s-do-egress-$(safe_cache_name "$CLUSTER_REF")-$(date +%Y%m%d-%H%M%S).log"
  local work_dir
  work_dir=$(mktemp -d "${TMPDIR:-/tmp}/k8s-do-egress.XXXXXX")
  chmod 700 "$work_dir"
  local remote_output="$work_dir/remote.log"
  local pod_output="$work_dir/pod.log"

  {
    echo "# k8s-do egress-check v3"
    echo "timestamp=$(date -Is)"
    echo "cluster=$CLUSTER_REF"
    echo "egress_node=$TARGET_NODE_NAME"
    echo "egress_node_ip=$TARGET_NODE_IP"
    echo "namespace=$namespace"
    echo "pod=$pod_name"
    echo "pod_ip=$pod_ip"
    echo "pod_node=$pod_node"
    echo "same_node=$([[ "$pod_node" == "$TARGET_NODE_NAME" ]] && echo true || echo false)"
    echo "egress_ip=$egress_ip"
    echo "destination=$dst"
    echo "port=$port"
    echo "timeout=$timeout_seconds"
    echo
  } | tee "$output_file"

  "$SSH_BIN" "${SSH_ARGS[@]}" "${K8S_DO_USER}@${TARGET_NODE_IP}" \
    bash -s -- "$egress_ip" "$dst" "$port" "$iface" "$pod_ip" "$capture_seconds" >"$remote_output" 2>&1 <<'REMOTE_EGRESS_V3' &
set -u
EGRESS_IP="$1"
DST="$2"
PORT="$3"
IFACE_OVERRIDE="${4:-}"
POD_IP="$5"
CAPTURE_SECONDS="$6"

section() { printf '\n## %s\n' "$1"; }
TMP_REMOTE=$(mktemp -d /tmp/k8s-do-egress.XXXXXX)
cleanup() { rm -rf "$TMP_REMOTE"; }
trap cleanup EXIT

if sudo -n true >/dev/null 2>&1; then
  PRIV=(sudo -n)
else
  PRIV=()
fi

OWNER_IF=$(ip -o -4 addr show 2>/dev/null | awk -v ip="$EGRESS_IP" '$0 ~ ("inet " ip "/") {print $2; exit}')
ROUTE_LINE=$(ip route get "$DST" 2>/dev/null | head -1 || true)
ROUTE_IF=$(printf '%s\n' "$ROUTE_LINE" | awk '{for(i=1;i<=NF;i++) if($i=="dev"){print $(i+1); exit}}')
ROUTE_GW=$(printf '%s\n' "$ROUTE_LINE" | awk '{for(i=1;i<=NF;i++) if($i=="via"){print $(i+1); exit}}')
ROUTE_SRC=$(printf '%s\n' "$ROUTE_LINE" | awk '{for(i=1;i<=NF;i++) if($i=="src"){print $(i+1); exit}}')
[[ -n "$IFACE_OVERRIDE" ]] && ROUTE_IF="$IFACE_OVERRIDE"

section "Node and Route Metadata"
printf 'host=%s\n' "$(hostname)"
printf 'owner_interface=%s\n' "${OWNER_IF:--}"
printf 'route_interface=%s\n' "${ROUTE_IF:--}"
printf 'route_gateway=%s\n' "${ROUTE_GW:--}"
printf 'route_source=%s\n' "${ROUTE_SRC:--}"
printf 'egress_ip_present=%s\n' "$([[ -n "$OWNER_IF" ]] && echo true || echo false)"
printf 'route_line=%s\n' "${ROUTE_LINE:--}"
ip -br addr 2>/dev/null | grep -F "$EGRESS_IP" || true

section "Neighbor and Duplicate-IP Probe"
[[ -n "$ROUTE_IF" ]] && ip neigh show dev "$ROUTE_IF" 2>/dev/null | grep -F "$EGRESS_IP" || true
if [[ -n "$ROUTE_IF" && "$EGRESS_IP" != *:* ]] && command -v arping >/dev/null 2>&1; then
  ROUTE_MAC=$(cat "/sys/class/net/$ROUTE_IF/address" 2>/dev/null || true)
  printf 'route_interface_mac=%s\n' "${ROUTE_MAC:--}"
  ARP_OUTPUT=$("${PRIV[@]}" arping -I "$ROUTE_IF" -c 5 -w 5 "$EGRESS_IP" 2>&1 || true)
  printf '%s\n' "$ARP_OUTPUT"
  MACS=$(printf '%s\n' "$ARP_OUTPUT" | grep -Eio '([0-9a-f]{2}:){5}[0-9a-f]{2}' | tr '[:upper:]' '[:lower:]' | sort -u || true)
  MAC_COUNT=$(printf '%s\n' "$MACS" | sed '/^$/d' | wc -l | tr -d ' ')
  printf 'arp_unique_response_macs=%s\n' "$MAC_COUNT"
  printf 'arp_response_macs=%s\n' "$(printf '%s' "$MACS" | paste -sd, -)"
else
  echo 'arp_probe_status=unavailable'
fi

TCPDUMP_ANY="$TMP_REMOTE/tcpdump-any.log"
TCPDUMP_EXT="$TMP_REMOTE/tcpdump-external.log"
CONNTRACK_EVT="$TMP_REMOTE/conntrack-events.log"

section "Capture Capability"
if command -v tcpdump >/dev/null 2>&1 && [[ -n "$ROUTE_IF" ]]; then
  echo 'tcpdump_available=true'
  "${PRIV[@]}" timeout "$CAPTURE_SECONDS" tcpdump -nn -l -i any \
    "(host $POD_IP or host $EGRESS_IP or host $DST) and port $PORT" >"$TCPDUMP_ANY" 2>&1 &
  PID_ANY=$!
  "${PRIV[@]}" timeout "$CAPTURE_SECONDS" tcpdump -nn -l -i "$ROUTE_IF" \
    "host $DST and port $PORT" >"$TCPDUMP_EXT" 2>&1 &
  PID_EXT=$!
else
  echo 'tcpdump_available=false'
  PID_ANY=''
  PID_EXT=''
fi

if command -v conntrack >/dev/null 2>&1; then
  echo 'conntrack_available=true'
  "${PRIV[@]}" timeout "$CAPTURE_SECONDS" conntrack -E -p tcp >"$CONNTRACK_EVT" 2>&1 &
  PID_CT=$!
else
  echo 'conntrack_available=false'
  PID_CT=''
fi

echo 'capture_ready=true'
# Give the caller enough time to observe readiness and generate Pod traffic.
sleep "$CAPTURE_SECONDS"

[[ -z "$PID_ANY" ]] || wait "$PID_ANY" 2>/dev/null || true
[[ -z "$PID_EXT" ]] || wait "$PID_EXT" 2>/dev/null || true
[[ -z "$PID_CT" ]] || wait "$PID_CT" 2>/dev/null || true

section "Tcpdump Any"
cat "$TCPDUMP_ANY" 2>/dev/null || true
section "Tcpdump External"
cat "$TCPDUMP_EXT" 2>/dev/null || true
section "Conntrack Events"
grep -E "$POD_IP|$EGRESS_IP|$DST" "$CONNTRACK_EVT" 2>/dev/null | tail -n 200 || true
section "Conntrack Snapshot"
if command -v conntrack >/dev/null 2>&1; then
  "${PRIV[@]}" conntrack -L -p tcp 2>/dev/null | grep -E "$POD_IP|$EGRESS_IP|$DST" | tail -n 200 || true
fi
REMOTE_EGRESS_V3
  local remote_pid=$!

  # Wait until ARP probing has finished and packet capture is ready.
  local ready=false
  local wait_i
  for ((wait_i=0; wait_i<20; wait_i++)); do
    if grep -q '^capture_ready=true$' "$remote_output" 2>/dev/null; then
      ready=true
      break
    fi
    if ! kill -0 "$remote_pid" 2>/dev/null; then
      break
    fi
    sleep 1
  done
  if [[ "$ready" != true ]]; then
    log_error "Remote capture did not become ready on node $TARGET_NODE_NAME."
    wait "$remote_pid" || true
    cat "$remote_output" | tee -a "$output_file"
    rm -rf "$work_dir"
    return 1
  fi

  local pod_rc=0
  set +e
  "$KUBECTL_BIN" --kubeconfig "$KUBECONFIG_PATH" --request-timeout="$KUBECTL_REQUEST_TIMEOUT" \
    -n "$namespace" exec "$pod_name" "${exec_container_args[@]}" -- \
    sh -c '
      DST="$1"; PORT="$2"; WAIT="$3"
      echo "test_destination=${DST}:${PORT}"
      if command -v nc >/dev/null 2>&1; then
        echo "test_method=nc"
        nc -vz -w "$WAIT" "$DST" "$PORT"
      elif command -v curl >/dev/null 2>&1; then
        echo "test_method=curl-telnet"
        curl -v --connect-timeout "$WAIT" "telnet://${DST}:${PORT}"
      elif command -v timeout >/dev/null 2>&1 && command -v bash >/dev/null 2>&1; then
        echo "test_method=bash-dev-tcp"
        timeout "$WAIT" bash -c "</dev/tcp/${DST}/${PORT}"
      else
        echo "test_method=unavailable"
        echo "No supported test tool found: nc, curl, or bash+timeout is required." >&2
        exit 127
      fi
    ' sh "$dst" "$port" "$timeout_seconds" >"$pod_output" 2>&1
  pod_rc=$?
  set -e

  wait "$remote_pid" || true

  {
    echo "## Pod Connectivity"
    cat "$pod_output"
    echo "pod_test_rc=$pod_rc"
    echo
    cat "$remote_output"
    echo
    echo "## Automated Verdict"
  } | tee -a "$output_file"

  local egress_present=false pod_seen=false snat_seen=false synack_seen=false
  local arp_count="" tcpdump_available=false conntrack_available=false
  grep -q '^egress_ip_present=true$' "$remote_output" && egress_present=true
  grep -q '^tcpdump_available=true$' "$remote_output" && tcpdump_available=true
  grep -q '^conntrack_available=true$' "$remote_output" && conntrack_available=true
  arp_count=$(awk -F= '/^arp_unique_response_macs=/{print $2; exit}' "$remote_output")

  if grep -E "${pod_ip//./\\.}([.:][0-9]+)?[[:space:]]*>[[:space:]]*${dst//./\\.}[.:]${port}" "$remote_output" >/dev/null 2>&1; then
    pod_seen=true
  fi
  if grep -E "${egress_ip//./\\.}[.:][0-9]+[[:space:]]*>[[:space:]]*${dst//./\\.}[.:]${port}" "$remote_output" >/dev/null 2>&1; then
    snat_seen=true
  fi
  if grep -E "${dst//./\\.}[.:]${port}[[:space:]]*>[[:space:]]*${egress_ip//./\\.}[.:][0-9]+.*Flags[[:space:]]*\[S\.\]" "$remote_output" >/dev/null 2>&1; then
    synack_seen=true
  elif grep -E "src=${dst//./\\.}.*dst=${egress_ip//./\\.}" "$remote_output" >/dev/null 2>&1; then
    synack_seen=true
  fi

  {
    [[ "$egress_present" == true ]] && echo "[PASS] Egress IP is present on the selected Egress Node." || echo "[FAIL] Egress IP is not present on the selected Egress Node."

    if [[ -n "$arp_count" && "$arp_count" =~ ^[0-9]+$ && "$arp_count" -gt 1 ]]; then
      echo "[CRITICAL] Multiple MAC addresses responded for the Egress IP. Duplicate ownership is strongly suspected."
    elif [[ -n "$arp_count" ]]; then
      echo "[INFO] ARP response MAC count: $arp_count. ARP alone cannot prove absence of duplication in overlay/proxy-ARP environments."
    else
      echo "[WARN] Duplicate-IP ARP evidence was unavailable."
    fi

    if ((pod_rc == 0)); then
      echo "[PASS] TCP connectivity from ${namespace}/${pod_name} to ${dst}:${port} succeeded."
    else
      echo "[FAIL] TCP connectivity from ${namespace}/${pod_name} to ${dst}:${port} failed (rc=$pod_rc)."
    fi

    if [[ "$tcpdump_available" == true ]]; then
      [[ "$pod_seen" == true ]] && echo "[PASS] Pod-originated traffic was observed on the Egress Node." || echo "[WARN] The Pod IP was not observed in tcpdump; local CNI/NAT processing may hide it or traffic may use a different Egress Node."
      [[ "$snat_seen" == true ]] && echo "[PASS] Outbound traffic with source Egress IP ${egress_ip} was observed." || echo "[FAIL] Expected SNAT source ${egress_ip} was not observed on the external interface."
      [[ "$synack_seen" == true ]] && echo "[PASS] Return traffic to Egress IP ${egress_ip} was observed." || echo "[WARN] Return traffic to Egress IP ${egress_ip} was not positively identified."
    else
      echo "[WARN] tcpdump evidence unavailable; SNAT and return-path verification could not be completed."
    fi

    [[ "$conntrack_available" == true ]] || echo "[WARN] conntrack evidence unavailable; the CNI may use another dataplane or the command/permission is missing."
    echo "[INFO] Evidence report: $output_file"
  } | tee -a "$output_file"

  rm -rf "$work_dir"

  if ((pod_rc != 0)) || [[ "$egress_present" != true ]] || [[ "$snat_seen" != true ]]; then
    return 2
  fi
  if [[ -n "$arp_count" && "$arp_count" =~ ^[0-9]+$ && "$arp_count" -gt 1 ]]; then
    return 3
  fi
  return 0
}

run_refresh() {
  local requested="${1:-}"
  if [[ -z "$requested" ]]; then
    rm -rf "$K8S_DO_CACHE_DIR/nodes" "$K8S_DO_CACHE_DIR/assets" "$K8S_DO_CACHE_DIR/clusters.tsv"
    mkdir -p "$K8S_DO_CACHE_DIR/nodes" "$K8S_DO_CACHE_DIR/assets"
    chmod 700 "$K8S_DO_CACHE_DIR/nodes" "$K8S_DO_CACHE_DIR/assets" 2>/dev/null || true
    log_info "All k8s-do caches were cleared."
    return 0
  fi

  resolve_cluster "$requested"
  rm -f "$(node_cache_file "$CLUSTER_REF")"
  rm -f "$K8S_DO_CACHE_DIR/assets/$(safe_cache_name "$CLUSTER_REF").kubeconfig"
  log_info "Cache cleared for: $CLUSTER_REF"
}

run_nodes() {
  load_node_rows "$1" true
  echo "Cluster: $CLUSTER_REF"
  print_nodes_table
}

run_interactive_cluster() {
  local cluster="$1"
  load_node_rows "$cluster"
  local selected
  selected=$(select_node_interactively) || return $?
  run_ssh "$cluster" "$selected"
}

completion_clusters() {
  list_all_cluster_refs
}

completion_node_values() {
  local cluster="$1"
  load_node_rows "$cluster" false 2>/dev/null || return 0
  local row name ip ready unsched version
  for row in "${NODE_ROWS[@]}"; do
    IFS=$'\t' read -r name ip ready unsched version <<<"$row"
    # Bash completion inserts only the node name.
    # Direct IP input is still supported by resolve_node_target(), but IPs are not
    # emitted as separate completion candidates because that made the list noisy.
    printf '%s\n' "$name"
  done | sort -u
}

completion_nodes() {
  local cluster="$1"
  load_node_rows "$cluster" false 2>/dev/null || return 0
  local row name ip ready unsched version status scheduling

  printf '%-55s %-16s %-10s %-12s %s\n' "NODE" "INTERNAL-IP" "STATUS" "SCHEDULING" "VERSION"
  printf '%-55s %-16s %-10s %-12s %s\n' "----" "-----------" "------" "----------" "-------"

  for row in "${NODE_ROWS[@]}"; do
    IFS=$'\t' read -r name ip ready unsched version <<<"$row"
    [[ "$ready" == "True" ]] && status="Ready" || status="NotReady"
    [[ "$unsched" == "true" ]] && scheduling="Disabled" || scheduling="Enabled"
    printf '%-55s %-16s %-10s %-12s %s\n'       "$name" "${ip:--}" "$status" "$scheduling" "$version"
  done
}

main() {
  require_command "$KUBECTL_BIN"
  require_command "$SSH_BIN"
  require_command base64

  (($# > 0)) || { show_usage; return 1; }

  case "$1" in
    list)
      (($# == 1)) || { show_usage; return 1; }
      print_cluster_list
      ;;
    nodes)
      (($# == 2)) || { show_usage; return 1; }
      run_nodes "$2"
      ;;
    check)
      (($# == 3)) || { show_usage; return 1; }
      run_check "$2" "$3"
      ;;
    exec)
      (($# >= 5)) || { show_usage; return 1; }
      run_exec "$2" "$3" "${@:4}"
      ;;
    doctor)
      (($# >= 3)) || { show_usage; return 1; }
      run_doctor "$2" "$3" "${@:4}"
      ;;
    egress-check)
      (($# >= 5)) || { show_usage; return 1; }
      run_egress_check "$2" "$3" "${@:4}"
      ;;
    refresh)
      (($# <= 2)) || { show_usage; return 1; }
      run_refresh "${2:-}"
      ;;
    version)
      echo "k8s-do $VERSION"
      ;;
    -h|--help|help)
      show_usage
      ;;
    __complete)
      case "${2:-}" in
        clusters) completion_clusters ;;
        # Human-readable node completion view: one line per Node with InternalIP.
        nodes) [[ -n "${3:-}" ]] && completion_nodes "$3" ;;
        # Machine-readable values used by Bash completion insertion.
        node-values) [[ -n "${3:-}" ]] && completion_node_values "$3" ;;
      esac
      ;;
    *)
      if (($# == 1)); then
        run_interactive_cluster "$1"
      elif (($# == 2)); then
        run_ssh "$1" "$2"
      else
        show_usage
        return 1
      fi
      ;;
  esac
}

main "$@"
