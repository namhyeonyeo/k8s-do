# shellcheck shell=bash

_cluster_ssh_completion() {
  local cur first_arg second_arg cli
  COMPREPLY=()
  cur="${COMP_WORDS[COMP_CWORD]}"
  first_arg="${COMP_WORDS[1]:-}"
  second_arg="${COMP_WORDS[2]:-}"
  cli="${CLUSTER_SSH_BIN:-cluster-ssh}"

  if [[ $COMP_CWORD -eq 1 ]]; then
    local candidates
    candidates="$($cli __complete clusters 2>/dev/null)"
    COMPREPLY=( $(compgen -W "list nodes check exec doctor egress-check refresh version help --help $candidates" -- "$cur") )
    return
  fi

  if [[ $COMP_CWORD -eq 2 ]]; then
    case "$first_arg" in
      nodes|check|exec|doctor|egress-check|refresh)
        local clusters
        clusters="$($cli __complete clusters 2>/dev/null)"
        COMPREPLY=( $(compgen -W "$clusters" -- "$cur") )
        return
        ;;
      list|version|help|--help)
        return
        ;;
      *)
        local nodes
        nodes="$($cli __complete nodes "$first_arg" 2>/dev/null)"
        COMPREPLY=( $(compgen -W "$nodes" -- "$cur") )
        return
        ;;
    esac
  fi

  if [[ $COMP_CWORD -eq 3 ]]; then
    case "$first_arg" in
      check|exec|doctor|egress-check)
        local nodes
        nodes="$($cli __complete nodes "$second_arg" 2>/dev/null)"
        COMPREPLY=( $(compgen -W "$nodes" -- "$cur") )
        return
        ;;
    esac
  fi

  case "$first_arg" in
    doctor)
      COMPREPLY=( $(compgen -W "--output" -- "$cur") )
      ;;
    egress-check)
      COMPREPLY=( $(compgen -W "--egress-ip --dst --port --namespace --pod-prefix --pod --container --iface --timeout --output" -- "$cur") )
      ;;
  esac
}

complete -F _cluster_ssh_completion cluster-ssh
