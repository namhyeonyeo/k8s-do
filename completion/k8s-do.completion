# shellcheck shell=bash
# k8s-do v3.2.5 bash completion
# Completion must be non-interactive: no kubectl, no SSH, no table output.
# Node completion reads cache only through: k8s-do __complete node-values <cluster>

_k8s_do_complete_node_target() {
  local cli="$1"
  local cluster="$2"
  local cur="$3"
  local nodes

  nodes="$(K8S_DO_COMPLETION=1 "$cli" __complete node-values "$cluster" 2>/dev/null || true)"
  COMPREPLY=( $(compgen -W "$nodes" -- "$cur") )
}

_k8s_do_completion() {
  local cur first_arg second_arg cli
  COMPREPLY=()
  cur="${COMP_WORDS[COMP_CWORD]}"
  first_arg="${COMP_WORDS[1]:-}"
  second_arg="${COMP_WORDS[2]:-}"
  cli="${K8S_DO_BIN:-k8s-do}"

  if [[ $COMP_CWORD -eq 1 ]]; then
    local candidates
    candidates="$(K8S_DO_COMPLETION=1 "$cli" __complete clusters 2>/dev/null || true)"
    COMPREPLY=( $(compgen -W "ssh list nodes check exec doctor egress-check refresh version help --help $candidates" -- "$cur") )
    return 0
  fi

  if [[ $COMP_CWORD -eq 2 ]]; then
    case "$first_arg" in
      ssh|nodes|check|exec|doctor|egress-check|refresh)
        local clusters
        clusters="$(K8S_DO_COMPLETION=1 "$cli" __complete clusters 2>/dev/null || true)"
        COMPREPLY=( $(compgen -W "$clusters" -- "$cur") )
        return 0
        ;;
      list|version|help|--help)
        return 0
        ;;
      *)
        # Backward-compatible form: k8s-do <cluster> <node>
        _k8s_do_complete_node_target "$cli" "$first_arg" "$cur"
        return 0
        ;;
    esac
  fi

  if [[ $COMP_CWORD -eq 3 ]]; then
    case "$first_arg" in
      ssh|check|exec|doctor|egress-check)
        _k8s_do_complete_node_target "$cli" "$second_arg" "$cur"
        return 0
        ;;
    esac
  fi

  case "$first_arg" in
    doctor)
      COMPREPLY=( $(compgen -W "--output" -- "$cur") )
      ;;
    egress-check)
      COMPREPLY=( $(compgen -W "--egress-ip --dst --port --namespace --pod-prefix --pod --container --iface --timeout --output --verbose" -- "$cur") )
      ;;
  esac
}

complete -F _k8s_do_completion k8s-do
